    "text_new2": {
      "type": "Text",
      "props": {
        "text": "langfuse scoring",
        "variant": "body"
      }
    },
    "text_new3": {
      "type": "Text",
      "props": {
        "text": "OpenRouter attribution",
        "variant": "body"
      }
    },
    "text_new4": {
      "type": "Text",
      "props": {
        "text": "onchain-monitor evidence verify",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading_manual": {
      "type": "Heading",
      "props": {
        "text": "Manual Review Required",
        "level": "h3"
      }

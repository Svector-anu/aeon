{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "aeon-update",
        "description": "Synced 63 upstream commits from aeonfun/aeon → PR"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "grid_stats",
        "sep1",
        "heading_new",
        "stack_new",
        "sep2",
        "heading_manual",
        "stack_manual",
        "sep3",
        "link_pr"
      ]
    },
    "grid_stats": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md"
      },
      "children": [
        "stat_commits",
        "stat_files",
        "stat_reviewed",
        "stat_merged"
      ]
    },
    "stat_commits": {
      "type": "Stat",
      "props": {
        "label": "Upstream Commits",
        "value": "63"
      }
    },
    "stat_files": {
      "type": "Stat",
      "props": {
        "label": "Files Applied",
        "value": "127"
      }
    },
    "stat_reviewed": {
      "type": "Stat",
      "props": {
        "label": "Need Review",
        "value": "25"
      }
    },
    "stat_merged": {

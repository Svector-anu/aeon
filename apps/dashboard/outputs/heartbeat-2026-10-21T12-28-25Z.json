      "props": {
        "text": "auto-merge",
        "level": "h3"
      }
    },
    "badge-failed-1": {
      "type": "Badge",
      "props": {
        "text": "Failed",
        "variant": "destructive"
      }
    },
    "metrics-auto-merge": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat-consecutive-1",
        "stat-success-1",
        "stat-lastrun-1"
      ]
    },
    "stat-consecutive-1": {
      "type": "Stat",
      "props": {
        "label": "Consecutive Failures",
        "value": "4"
      }
    },
    "stat-success-1": {
      "type": "Stat",
      "props": {
        "label": "Success Rate",
        "value": "35%",
        "trend": "down"
      }
    },
    "stat-lastrun-1": {

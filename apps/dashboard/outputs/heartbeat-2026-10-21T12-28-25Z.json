{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Heartbeat",
        "description": "Skill health status"
      },
      "children": [
        "alert-critical",
        "separator-1",
        "failures-stack"
      ]
    },
    "alert-critical": {
      "type": "Alert",
      "props": {
        "title": "Critical: Multiple Skill Failures",
        "message": "Shared error signature across all failures points to common harness or API dependency issue, not per-skill bugs",
        "type": "error"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "failures-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "failure-auto-merge",
        "failure-aeon-update",
        "failure-heartbeat",
        "diagnostic-section"
      ]
    },
    "failure-auto-merge": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "header-auto-merge",
        "metrics-auto-merge"
      ]
    },
    "header-auto-merge": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "title-auto-merge",
        "badge-failed-1"
      ]
    },
    "title-auto-merge": {
